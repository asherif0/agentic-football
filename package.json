{
  "name": "futsal-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "worker": "node --import tsx scripts/simulation-worker.ts",
    "worker:stop": "node --import tsx scripts/stop-simulation-worker.ts",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "improvement:smoke": "node --import tsx scripts/improvement-smoke.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^18.0.6",
    "next": "^15.5.0",
    "openai": "^7.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "node": "^22.23.3",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "engines": {
    "node": ">=22"
  }
}
